_xlabel(\"PECD-implied national CF (binned)\")\naxes[1].set_ylabel(\"Mean bias (ours - PECD)\")\naxes[1].set_title(\"Bias vs. capacity-factor level\")\n\nfig.tight_layout()\nfig.savefig(paths.images_path / \"33_bias_vs_cf_level.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()","key":"RQW0X00Som"},{"type":"outputs","id":"_DrmLJDrHCCVaD54rXo5T","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"/tmp/ipykernel_581674/136534992.py:23: UserWarning: FigureCanvasAgg is non-interactive, and thus cannot be shown\n  plt.show()\n"},"children":[],"key":"waslmeTXSb"}],"key":"UHLdqiJK69"}],"key":"TD3JnHu5Fy"},{"type":"block","kind":"notebook-content","children":[{"type":"container","kind":"figure","children":[{"type":"image","url":"/pecd-replication/build/33_bias_vs_cf_level-4f6b127d4ad5d5b98641cdf52396e3d8.png","alt":"Left: hourly scatter, 2019-2025. Right: mean bias by PECD capacity-factor bin.","data":{"altTextIsAutoGenerated":true},"key":"bxXENNhX5O","urlSource":"../../output/images/33_bias_vs_cf_level.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"fig-33-bias-vs-cf-level","identifier":"fig-33-bias-vs-cf-level","html_id":"fig-33-bias-vs-cf-level","enumerator":"2","children":[{"type":"text","value":"Figure ","key":"Hjq0200bCQ"},{"type":"text","value":"2","key":"NPYpglPDea"},{"type":"text","value":":","key":"eaqZ6gmBif"}],"template":"Figure %s:","key":"vdvHKGWEeX"},{"type":"text","value":"Left: hourly scatter, 2019-2025. Right: mean bias by PECD capacity-factor bin.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"FzrBHYLXfh"}],"key":"wT0iUtCDTE"}],"key":"hXnHBs9roj"}],"label":"fig-33-bias-vs-cf-level","identifier":"fig-33-bias-vs-cf-level","enumerator":"2","html_id":"fig-33-bias-vs-cf-level","key":"Pt3TsyiBdo"}],"key":"sp86vQpPwH"},{"type":"block","kind":"notebook-co