otebook-code","data":{"execution":{"iopub.execute_input":"2026-07-29T06:40:23.407287Z","iopub.status.busy":"2026-07-29T06:40:23.407193Z","iopub.status.idle":"2026-07-29T06:40:23.894318Z","shell.execute_reply":"2026-07-29T06:40:23.893841Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport numpy as np\nimport pandas as pd\n\nfrom pecdr.domain import FULL_YEAR_BACKTEST_YEARS\nfrom pecdr.paths import ProjPaths\n\npaths = ProjPaths()\npaths.ensure_directories()","key":"U05D9hdJ20"},{"type":"outputs","id":"wnmZLaTX3L65F2yfyAy73","children":[],"key":"hRFozdUdya"}],"key":"zQLHl57HaT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Load our modeled series and build the PECD-implied comparison series","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"v9XzkXvQEA"}],"identifier":"load-our-modeled-series-and-build-the-pecd-implied-comparison-series","label":"Load our modeled series and build the PECD-implied comparison series","html_id":"load-our-modeled-series-and-build-the-pecd-implied-comparison-series","implicit":true,"key":"venGWOtl2J"}],"key":"GbH43yGMcq"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-29T06:40:23.896198Z","iopub.status.busy":"2026-07-29T06:40:23.895950Z","iopub.status.idle":"2026-07-29T06:40:24.014605Z","shell.execute_reply":"2026-07-29T06:40:24.014053Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"ours = pd.read_parquet(paths.wind_offshore_full_year_cf_file)\nzone_cols = [c for c in ours.columns if c != \"national\"]\n\npecd_peof = pd.read_parquet(paths.pecd_wind_offshore_capacity_factors_file)\n\npecd_national_parts = []\nfor year in FULL_YEAR_BACKTEST_YEARS:\n    year_weights = pd.read_parquet(paths.wind_offshore_plant_panel_by_year_file(year)).groupby(\"peof_zone\")[\"capacity_mw\"].sum().reindex(zone_cols)\n    year_slice = pecd_peof.loc[year, zone_cols]\n    pecd_national_parts.append((year_slice * year_weights).sum(axis=1) / year_weights.sum())\npecd_national = pd.concat(pecd_national_parts).reindex(ours.index)\n\ncomparison = pd.DataFrame({\"our_national_cf\": ours[\"national\"], \"pecd_implied_national_cf\": pecd_national}).dropna()\ncomparison[\"diff\"] = comparison[\"our_national_cf\"] - comparison[\"pecd_implied_national_cf\"]\nprint(f\"Hours compared: {len(comparison):,}\")\nprint(f\"Overall MAE: {comparison['diff'].abs().mean():.4f}\")\nprint(f\"Overall bias: {comparison['diff'].mean():.4f}\")\nprint(f\"Overall correlation: {comparison['our_national_cf'].corr(comparison['pecd_implied_national_cf']):.4f}\")","key":"VemARQFJpE"},{"type":"outputs","id":"FzhSsbKxrSPYM1e_BqCnj","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Hours compared: 61,368\nOverall MAE: 0.0592\nOverall bias: 0.0429\nOverall correlation: 0.9861\n"},"children":[],"key":"Z8AjXhh6td"}],"key":"CiEjBSrRNl"}],"key":"c4k0IvaDL6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Time series, full period","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JMj5lbNWR9"}],"identifier":"time-series-full-period","label":"Time series, full period","html_id":"time-series-full-period","implicit":true,"key":"H5OqhT3c8j"}],"key":"a9idnkkmo6"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-29T06:40:24.015878Z","iopub.status.busy":"2026-07-29T06:40:24.015770Z","iopub.status.idle":"2026-07-29T06:40:24.939024Z","shell.execute_reply":"2026-07-29T06:40:24.938222Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(figsize=(14, 4))\ncomparison[\"our_national_cf\"].plot(ax=ax, label=\"Our modeled national CF\", alpha=0.8, linewidth=0.4)\ncomparison[\"pecd_implied_national_cf\"].plot(ax=ax, label=\"PECD-implied national CF\", alpha=0.8, linewidth=0.4)\nax.set_ylabel(\"Germany-wide offshore wind CF\")\nax.set_title(f\"{FULL_YEAR_BACKTEST_YEARS[0]}-{FULL_YEAR_BACKTEST_YEARS[-1]}: our modeled vs. PECD-implied national capacity factor\")\nax.legend()\nfig.tight_layout()\nfig.savefig(paths.images_path / \"33_full_year_timeseries.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()","key":"np2q1f0Xw5"},{"type":"outputs","id":"OF_nN56rGDKP0HSKcnau9","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"/tmp/ipykernel_581674/1815541779.py:9: UserWarning: FigureCanvasAgg is non-interactive, and thus cannot be shown\n  plt.show()\n"},"children":[],"key":"DJrcstllYz"}],"key":"ly5jUNvbUH"}],"key":"dzJ4JLiVYg"},{"type":"block","kind":"notebook-content","children":[{"type":"container","kind":"figure","children":[{"type":"image","url":"/pecd-replication/build/33_full_year_timeser-3dcb3bda23c9ff336ce65003277c618d.png","alt":"2019-2025, hourly: our modeled vs. PECD-implied national capacity factor.","data":{"altTextIsAutoGenerated":true},"key":"fwJaIuKNYV","urlSource":"../../output/images/33_full_year_timeseries.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"fig-33-full-year-timeseries","identifier":"fig-33-full-year-timeseries","html_id":"fig-33-full-year-timeseries","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"wjhRHENgF3"},{"type":"text","value":"1","key":"D6EgZAuwro"},{"type":"text","value":":","key":"RZCenW15YC"}],"template":"Figure %s:","key":"iN3VkIFaa1"},{"type":"text","value":"2019-2025, hourly: our modeled vs. PECD-implied national capacity factor.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PCZArLimZI"}],"k