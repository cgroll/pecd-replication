ial_x_mastr\", \"2_delu_physics_no_bias\", \"3_pecd_replication\"], [\"1. PECD official x MaStR\", \"2. delu physics\", \"3. PECD replication\"]):\n    sub = comparison[[col, \"4_smard_implied\"]].dropna()\n    diff = sub[col] - sub[\"4_smard_implied\"]\n    corr = sub[col].corr(sub[\"4_smard_implied\"])\n    stats_rows.append({\"approach\": label, \"n_hours\": len(sub), \"mae\": float(diff.abs().mean()), \"bias\": float(diff.mean()), \"corr\": float(corr)})\n\n    ax.scatter(sub[\"4_smard_implied\"], sub[col], s=2, alpha=0.05)\n    lims = [0, max(sub.max())]\n    ax.plot(lims, lims, \"k--\", alpha=0.5, label=\"1:1\")\n    ax.set_xlabel(\"SMARD-implied CF\")\n    ax.set_ylabel(f\"{label} CF\")\n    ax.set_title(f\"{label}\\nMAE={diff.abs().mean():.3f}, corr={corr:.3f}\")\nfig.tight_layout()\nfig.savefig(paths.images_path / \"12_approaches_vs_smard.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()\n\nstats = pd.DataFrame(stats_rows)\nstats","key":"Cmmvn9J0lF"},{"type":"outputs","id":"jLfT6fib7UOkIJPvLEc04","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"/tmp/ipykernel_468515/454666041.py:17: UserWarning: FigureCanvasAgg is non-interactive, and thus cannot be shown\n  plt.show()\n"},"children":[],"key":"RFrzAXOgWg"},{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>approach</th>\n      <th>n_hours</th>\n      <th>mae</th>\n      <th>bias</th>\n      <th>corr</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>1. PECD official x MaStR</td>\n      <td>61368</td