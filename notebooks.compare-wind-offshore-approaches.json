: float(corr)})\n\n    ax.scatter(sub[\"4_smard_implied\"], sub[col], s=2, alpha=0.05)\n    lims = [0, max(sub.max())]\n    ax.plot(lims, lims, \"k--\", alpha=0.5, label=\"1:1\")\n    ax.set_xlabel(\"SMARD-implied CF\")\n    ax.set_ylabel(f\"{label} CF\")\n    ax.set_title(f\"{label}\\nMAE={diff.abs().mean():.3f}, corr={corr:.3f}\")\nfig.tight_layout()\nfig.savefig(paths.images_path / \"34_approaches_vs_smard.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()\n\nstats = pd.DataFrame(stats_rows)\nstats","key":"fxWoZG3OPN"},{"type":"outputs","id":"a65kcDoRbMlSZnHnvsLE5","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"/tmp/ipykernel_589074/3270078833.py:17: UserWarning: FigureCanvasAgg is non-interactive, and thus cannot be shown\n  plt.show()\n"},"children":[],"key":"WD8Qe7yqqy"},{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>approach</th>\n      <th>n_hours</th>\n      <th>mae</th>\n      <th>bias</th>\n      <th>corr</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>1. PECD official x MaStR</td>\n      <td>61368</td>\n      <td>0.093568</td>\n      <td>0.073239</td>\n      <td>0.902358</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>2. Naive physics (no PECD)</td>\n      <td>61368</td>\n      <td>0.133096</td>\n      <td>0.070579</td>\n      <td>0.882324</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>3. PECD replication</td>\n      <td>61368</td>\n      <td>0.128137</td>\n      <td>0.107863</td>\n      <td>0.916476</td>\n    </tr>\n  </tb