ier":"load-data-and-restrict-to-pecds-actually-modeled-zones","label":"Load data and restrict to PECD’s actually-modeled zones","html_id":"load-data-and-restrict-to-pecds-actually-modeled-zones","implicit":true,"key":"jK0MZE6aXo"}],"key":"QjO4iPVO5O"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-29T07:22:07.601628Z","iopub.status.busy":"2026-07-29T07:22:07.601384Z","iopub.status.idle":"2026-07-29T07:22:07.671719Z","shell.execute_reply":"2026-07-29T07:22:07.670951Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"pecd_peof_cf = pd.read_parquet(paths.pecd_wind_offshore_capacity_factors_file)\ntarget_panel = pd.read_parquet(paths.target_panel_file)\nmastr_peof_month = pd.read_parquet(paths.mastr_capacity_by_peof_month_file)\n\nall_zones = pecd_peof_cf.columns.tolist()\nvalid_zones = pecd_peof_cf.columns[pecd_peof_cf.notna().any()].tolist()\nprint(f\"PEOF zones in PECD's product: {all_zones}\")\nprint(f\"Zones PECD actually has data for: {valid_zones}\")\nprint(f\"Zones dropped as 100% NaN in PECD's own product: {sorted(set(all_zones) - set(valid_zones))}\")\n\ncf = pecd_peof_cf.loc[FULL_YEAR_BACKTEST_YEARS[0]:FULL_YEAR_BACKTEST_YEARS[-1], valid_zones]\nsmard_mw = target_panel[\"wind_offshore\"].reindex(cf.index)\nkeep = smard_mw.notna()\ncf, smard_mw = cf[keep], smard_mw[keep]\nprint(f\"Hours in fit: {len(cf):,}\")","key":"zhfBaqZ7aR"},{"type":"outputs","id":"yjxv_6oxPNKJhcQtVyUjB","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"PEOF zones in PECD's product: ['DE011_OFF', 'DE012_OFF', 'DE013_OFF', 'DE014_OFF', 'DE015_OFF', 'DE02_OFF']\nZones PECD actually has data for: ['DE011_OFF', 'DE012_OFF', 'DE02_OFF']\nZones dropped as 100% NaN in PECD's own product: ['DE013_OFF', 'DE014_OFF', 'DE015_OFF']\nHours in fit: 61,368\n"},"children":[],"key":"uiHgSXerXC"}],"key":"fy2wx6Efbd"}],"key":"bYcC3tSkMU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the monotonic-increment design matrix and solve NNLS","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Vey5Rkm5GP"}],"identifier":"build-the-monotonic-increment-design-matrix-and-solve-nnls","label":"Build the monotonic-increment design matrix and solve NNLS","html_id":"build-the-monotonic-increment-design-matrix-and-solve-nnls","implicit":true,"key":"lNcCHuSbph"}],"key":"tnklAryThD"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-29T07:22:07.673739Z","iopub.status.busy":"2026-07-29T07:22:07.673403Z","iopub.status.idle":"2026-07-29T07:22:08.799335Z","shell.execute_reply":"2026-07-29T07:22:08.798768Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"zones = list(cf.columns)\nrow_period = cf.index.to_period(\"M\")\nmonths = row_period.unique().sort_values()\nmonth_idx = months.get_indexer(row_period)\nn_zones, n_months = len(zones), len(months)\n\n# mask[t, k] = True if hour t's month is on or after month k -- shared\n# across zones, since it only depends on which month each hour falls in.\nmonth_mask = np.arange(n_months)[None, :] <= month_idx[:, None]\ndesign_matrix = np.hstack([cf[z].to_numpy()[:, None] * month_mask for z in zones])\n\nfitted_increments, residual_norm = nnls(design_matrix, smard_mw.to_numpy(), maxiter=10_000)\nfitted_capacity_by_month = fitted_increments.reshape(n_zones, n_months).cumsum(axis=1)\nfitted_capacity = pd.DataFrame(fitted_capacity_by_month.T, index=months, columns=zones)\nprint(f\"Non-zero monthly increments: {(fitted_increments > 1.0).sum()} / {len(fitted_increments)}\")\nfitted_capacity.iloc[[0, -1]]","key":"imLEVSpoeh"},{"type":"outputs","id":"JvMrOyHWpI8n3Mcp3Ye1k","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Non-zero monthly increments: 17 / 252\n"},"children":