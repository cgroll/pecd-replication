rly_capacity_by_zone(mastr_peof_month, cf.index, zone_col=\"region_code\").reindex(columns=zones).fillna(0)\npredicted_mastr_mw = (cf.to_numpy() * mastr_hourly.to_numpy()).sum(axis=1)\n\nsmard_values = smard_mw.to_numpy()\nstats = pd.DataFrame([\n    {\n        \"capacity_vector\": \"Fitted (optimal, monotonic)\",\n        \"mae_mw\": float(np.mean(np.abs(predicted_fitted_mw - smard_values))),\n        \"bias_mw\": float(np.mean(predicted_fitted_mw - smard_values)),\n        \"corr\": float(np.corrcoef(predicted_fitted_mw, smard_values)[0, 1]),\n    },\n    {\n        \"capacity_vector\": \"MaStR-derived (3 PECD-modeled zones)\",\n        \"mae_mw\": float(np.mean(np.abs(predicted_mastr_mw - smard_values))),\n        \"bias_mw\": float(np.mean(predicted_mastr_mw - smard_values)),\n        \"corr\": float(np.corrcoef(predicted_mastr_mw, smard_values)[0, 1]),\n    },\n])\nstats","key":"yphUss3DS9"},{"type":"outputs","id":"QPTErAeGM3MLTRo6ZKXJK","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":5,"metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>capacity_vector</th>\n      <th>mae_mw</th>\n      <th>bias_mw</th>\n      <th>corr</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>Fitted (optimal, monotonic)</td>\n      <td>559.199178</td>\n      <td>-94.994318</td>\n      <td>0.909382</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>MaStR-derived (3 PECD-modeled zones)</td>\n      <td>709.680778</td>\n      <td>504.070001</td>\n      <td>0.898214</td>\n    </tr>\n  </tbody>\n</table>\n</div>","content_type":"text/html"},"text/plain":{"content":"                        capacity_vector      mae_mw     bias_mw      corr\n0           Fitted (optimal, monotonic)  559.199178  -94.994318  0.909382\n1  MaStR-derived (3 PECD-modeled zones)  709.680778  504.070001  0.898214","content_type":"text/plain"}}},"children":[],"key":"YCFKKc2Zab"}],"key":"L6jo5SW6vU"}],"key":"WaXlrcJSWP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Time series: both reconstructions vs. SMARD actual","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DRXerJYrOT"}],"identifier":"time-series-both-reconstructions-vs-smard-actual","label":"Time series: both reconstructions vs. SMARD actual","html_id":"time-series-both-reconstructions-vs-smard-actual","implicit":true,"key":"VBVa0EoYAV"}],"key":"CCBp5xHW0j"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-29T07:22:09.667160Z","iopub.status.busy":"2026-07-29T07:22:09.667008Z","iopub.status.idle":"2026-07-29T07:22:10.828598Z","shell.execute_reply":"2026-07-29T07:22:10.827772Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(figsize=(14, 4))\npd.Series(smard_values, index=cf.index).plot(ax=ax, label=\"SMARD actual\", alpha=0.8, linewidth=0.4)\npd.Series(predicted_fitted_mw, index=cf.index).plot(ax=ax, label=\"Fitted-optimal reconstruction\", alpha=0.8, linewidth=0.4)\npd.Series(predicted_mastr_mw, index=cf.index).plot(ax=ax, label=\"MaStR-weighted reconstruction\", alpha=0.8, linewidth=0.4)\nax.set_ylabel(\"Germany-wide offshore wind generation (MW)\")\nax.set_title(f\"Fitted vs. MaStR-weighted vs. SMARD actual, {PERIOD_LABEL}\")\nax.legend()\nfig.tight_layout()\nfig.savefig(paths.images_path / \"35_fit_quality_vs_smard.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()","key":"bnj2cjP7hl"},{"type":"outputs","id":"A92WRnYsp1jxKe_jpgnXT","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"/tmp/ipykernel_587417/3201276491.py:10: UserWarning: FigureCanvasAgg is non-interactive, and thus cannot be shown\n  plt.show()\n"},"children":[],"key":"OwO2vOvm3j"}],"key":"ZeEa2t37WT"}],"key":"iSyDqd0yOd"},{"type":"block","kind":"notebook-content","children":[{"type":"container","kind":"figure","children":[{"type":"image","url":"/pecd-replication/build/35_fit_quality_vs_sm-20b1b4c2227c9bf58fc4da5a2438288b.png","alt":"Fitted-optimal and MaStR-weighted reconstructions vs. SMARD’s actual offshore generation, 2019-2025.","data":{"altTextIsAutoGenerated":true},"key":"twJmDJn2fI","urlSource":"../../output/images/35_fit_quality_vs_smard.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"fig-35-fit-quality-vs-smard","identifier":"fig-35-fit-quality-vs-smard","html_id":"fig-35-fit-quality-vs-smard","enumerator":"2","children":[{"type":"text","value":"Figure ","key":"pllaK35LGh"},{"type":"text","value":"2","key":"Ce7cuodu2f"},{"type":"text","value":":","key":"g44Emv1QZL"}],"template":"Figure %s:","key":"IZ2A6ToGcz"},{"type":"text","value":"Fitted-optimal and MaStR-weighted reconstructions vs. SMARD’s actual offshore generation, 2019-2025.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"S7AsMdURc9"}],"key":"zXMkPW7dSn"}],"key":"APLY8b0e94"}],"label":"fig-35-fit-quality-vs-smard","identifier":"fig-35-fit-quality-vs-smard","enumerator":"2","html_id":"fig-35-fit-quality-vs-smard","key":"CHWFh6ElFe"},{"type":"heading","depth":2,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Reading the result","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"oaqCj1s1Bn"}],"identifier":"reading-the-result","label":"Reading the result","html_id":"reading-the-result","implicit":true,"key":"KR7O3y9BZu"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"The optimal capacity vector drives bias to roughly zero (vs. a clear\npositive bias from the MaStR-derived weights) -- a real chunk of the\npreviously-observed bias ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"Vgjci7aF3I"},{"type":"strong","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"is","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"ExatdEtopp"}],"key":"Mlk5TgbO20"},{"type":"text","value":" attributable to our own capacity\naccounting, not to PECD’s modeling or to curtailment. But correlation\nbarely moves between the two -- reweighting capacity fixes the ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"fNFb2wvzhG"},{"type":"emphasis","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"level","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"wh9r7LIb6i"}],"key":"QE3Q7kgmt1"},{"type":"text","value":",\nnot the ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"ppoIFCsOlw"},{"type":"emphasis","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"shape","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"m8nhjevpT6"}],"key":"UAVqr7o9qp"},{"type":"text","value":". Since the fitted vector is, by construction, the best\nany monotonic per-zone capacity story can possibly do, the remaining\ncorrelation gap can’t be closed by better fleet data -- it needs\nsomething dynamic that a static (or monotonically growing) capacity\nvector structurally can’t represent: curtailment, outages, or another\ntime-varying effect neither this fit nor PECD’s own product attempts to\nmodel.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"ex53j1v9t1"}],"key":"fqvffPM1q5"}],"key":"yr3ZFsjcrb"}],"key":"wsdoR9nd4m"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Comparing all wind-offshore approaches, plus SMARD","url":"/notebooks/compare-wind-offshore-approaches","group":"Wind offshore replication"},"next":{"title":"What drives the offshore gap against SMARD?","url":"/notebooks/analyse-wind-offshore-bias-drivers","group":"Wind offshore replication"}}},"domain":"http://localhost:3000"}