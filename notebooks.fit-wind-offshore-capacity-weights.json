:{"execution":{"iopub.execute_input":"2026-07-29T07:22:08.802885Z","iopub.status.busy":"2026-07-29T07:22:08.802611Z","iopub.status.idle":"2026-07-29T07:22:09.636965Z","shell.execute_reply":"2026-07-29T07:22:09.636289Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"mastr_wide = (\n    mastr_peof_month.assign(year_month=lambda d: d[\"month\"].dt.to_period(\"M\"))\n    .groupby([\"year_month\", \"region_code\"])[\"capacity_mw\"]\n    .sum()\n    .unstack(\"region_code\")\n    .reindex(months)\n    .reindex(columns=zones)\n    .fillna(0)\n)\n\nfig, axes = plt.subplots(2, 2, figsize=(13, 8), sharex=True)\nper_zone_axes, total_ax = axes.flat[: len(zones)], axes.flat[len(zones)]\nfor ax, zone in zip(per_zone_axes, zones):\n    fitted_capacity[zone].plot(ax=ax, label=\"Fitted (optimal)\", linewidth=1.5)\n    mastr_wide[zone].plot(ax=ax, label=\"MaStR-derived\", linewidth=1.5, linestyle=\"--\")\n    ax.set_title(zone)\n    ax.set_ylabel(\"Capacity (MW)\")\n    ax.legend()\nfor ax in axes.flat[len(zones) + 1 :]:\n    ax.set_visible(False)\n\nfitted_capacity.sum(axis=1).plot(ax=total_ax, label=\"Fitted total\", linewidth=1.5, color=\"black\")\nmastr_wide.sum(axis=1).plot(ax=total_ax, label=\"MaStR total (3 modeled zones)\", linewidth=1.5, linestyle=\"--\", color=\"black\")\ntotal_ax.set_title(\"National total (3 PECD-modeled zones)\")\ntotal_ax.set_ylabel(\"Capacity (MW)\")\ntotal_ax.legend()\nfig.suptitle(f\"Fitted vs. MaStR-derived offshore capacity, {PERIOD_LABEL}\")\nfig.tight_layout()\nfig.savefig(paths.images_path / \"35_fitted_capacity_trajectories.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()","key":"tqCY5f6BHw"},{"type":"outputs","id":"Xwd8xU755kuoM4HFPXyCA","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"/tmp/ipykernel_587417/2824579696.py:30: UserWarning: FigureCanvasAgg is non-interactive, and thus cannot be shown\n  plt.show()\n"},"children":[],"key":"T75DpjUZcq"}],"key":"VzgnX1EETh"}],"key":"okDXrCCXHH"},{"type":"block","kind":"notebook-content","children":[{"type":"container","kind":"figure","children":[{"type":"image","url":"/pecd-replication/build/35_fitted_capacity_t-4d227d15cd3be81ccae3c0cf24a07afe.png","alt":"Fitted (optimal, monotonic) vs. MaStR-derived offshore capacity by PEOF zone and nationally, 2019-2025.","data":{"altTextIsAutoGenerated":true},"key":"AKP6ZmwOV9","urlSource":"../../output/images/35_fitted_capacity_trajectories.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"fig-35-fitted-capacity-trajectories","identifier":"fig-35-fitted-capacity-trajectories","html_id":"fig-35-fitted-capacity-trajectories","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"FY22nPDQsz"},{"type":"text","value":"1","key":"I7F4saf5Z6"},{"type":"text","value":":","key":"voNKp17hFr"}],"template":"Figure %s:","key":"VEAL0HftzM"},{"type":"text","value":"Fitted (optimal, monotonic) vs. MaStR-derived offshore capacity by PEOF zone and nationally, 2019-2025.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"CTWN4Zp00e"}],"key":"rEkTIvtFeD"}],"key":"VgDovjxE5c"}],"label":"fig-35-fitted-capacity-trajectories","identifier":"fig-35-fitted-capacity-trajectories","enumerator":"1","html_id":"fig-35-fitted-capacity-trajectories","key":"HVkW6jvIIS"}],"key":"jqDLDLikU2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Does the optimal capacity vector actually fit SMARD better?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RhbEkEHxqs"}],"identifier":"does-the-optimal-capacity-vector-actually-fit-smard-better","label":"Does the optimal capacity vector actually fit SMARD better?","html_id":"does-the-optimal-capacity-vector-