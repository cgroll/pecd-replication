rly_capacity_by_zone(mastr_peof_month, cf.index, zone_col=\"region_code\").reindex(columns=zones).fillna(0)\npredicted_mastr_mw = (cf.to_numpy() * mastr_hourly.to_numpy()).sum(axis=1)\n\nsmard_values = smard_mw.to_numpy()\nstats = pd.DataFrame([\n    {\n        \"capacity_vector\": \"Fitted (optimal, monotonic)\",\n        \"mae_mw\": float(np.mean(np.abs(predicted_fitted_mw - smard_values))),\n        \"bias_mw\": float(np.mean(predicted_fitted_mw - smard_values)),\n        \"corr\": float(np.corrcoef(predicted_fitted_mw, smard_values)[0, 1]),\n    },\n    {\n        \"capacity_vector\": \"MaStR-derived (3 PECD-modeled zones)\",\n        \"mae_mw\": float(np.mean(np.abs(predicted_mastr_mw - smard_values))),\n        \"bias_mw\": float(np.mean(predicted_mastr_mw - smard_values)),\n        \"corr\": float(np.corrcoef(predicted_mastr_mw, smard_values)[0, 1]),\n    },\n])\nstats","key":"VPGG68rK9D"},{"type":"outputs","id":"aof07cawYDUhwF0w0JDBt","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":5,"metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>capacity_vector</th>\n      <th>mae_mw</th>\n      <th>bias_mw</th>\n      <th>corr</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>Fitted (optimal, monotonic)</td>\n      <td>559.199178</td>\n      <td>-94.994318</td>\n      <td>0.909382</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>MaStR-derived (3 PECD-modeled zones)</td>\n      <td>709.680778</td>\n      <td>504.070001</td>\n      <td>0.898214</td>\n    </tr>\n  </tbody>\n</table>\n</div>","content_type":"text/html"},"text/plain":{"content":"                        capacity_vector      mae_mw     bias_mw      corr\n0           Fitted (optimal, monotonic)  559.199178  -94.994318  0.909382\n1  MaStR-derived (3 PECD-modeled zones)  709.680778  504.070001  0.898214","content_type":"text/plain"}}},"children":[],"key":"pFIGaq5KpK"}],"key":"fnr1l8eZJ8"}],"key":"aYfGhIQNRi"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Time series: both reconstructions vs. SMARD actual","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yZ0pJm77f4"}],"identifier":"time-series-both-reconstructions-vs-smard-actual","label":"Time series: both reconstructions vs. SMARD actual","html_id":"time-series-both-reconstructions-vs-smard-actual","implicit":true,"key":"X3OV0iipqS"}],"key":"k671wu5skf"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-29T07:22:09.667160Z","iopub.status.busy":"2026-07-29T07:22:09.667008Z","iopub.status.idle":"2026-07-29T07:22:10.828598Z","shell.execute_reply":"2026-07-29T07:22:10.827772Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(figsize=(14, 4))\npd.Series(smard_values, index=cf.index).plot(ax=ax, label=\"SMARD actual\", alpha=0.8, linewidth=0.4)\npd.Series(predicted_fitted_mw, index=cf.index).plot(ax=ax, label=\"Fitted-optimal reconstruction\", alpha=0.8, linewidth=0.4)\npd.Series(predicted_mastr_mw, index=cf.index).plot(ax=ax, label=\"MaStR-weighted reconstruction\", alpha=0.8, linewidth=0.4)\nax.set_ylabel(\"Germany-wide offshore wind generation (MW)\")\nax.set_title(f\"Fitted vs. MaStR-weighted vs. SMARD actual, {PERIOD_LABEL}\")\nax.legend()\nfig.tight_layout()\nfig.savefig(paths.images_path / \"35_fit_quality_vs_smard.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()","key":"RrsAaGXzo3"},{"type":"outputs","id":"7NS4Nz0TTTj7DbIPaivSW","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"/tmp/ipykernel_587417/3201276491.py:10: UserWarning: FigureCanvasAgg is non-interactive, and thus cannot be shown\n  plt.show()\n"},"children":[],"key":"Te42yinr02"}],"key":"MUkfZf1nY8"}],"key":"SqYhNWH8vM"},{"type":"block","kind":"notebook-content","children":[{"type":"container","kind":"figure","children":[{"type":"image","url":"/pecd-replication/build/35_fit_quality_vs_sm-c4ad960155807812858acd9ce563f4d0.png","alt":"Fitted-optimal and MaStR-weighted reconstructions vs. SMARD’s actual offshore generation, 2019-2025.","data":{"altTextIsAutoGenerated":true},"key":"n4vtZHKJjc","urlSource":"../../output/images/35_fit_quality_vs_smard.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"fig-35-fit-quality-vs-smard","identifier":"fig-35-fit-quality-vs-smard","html_id":"fig-35-fit-quality-vs-smard","enumerator":"2","children":[{"type":"text","value":"Figure ","key":"sVe001FuC2"},{"type":"text","value":"2","key":"bKZOOWEg6m"},{"type":"text","value":":","key":"FABuB9I14S"}],"template":"Figure %s:","key":"AFNZ7Hq2Gy"},{"type":"text","value":"Fitted-optimal and MaStR-weighted reconstructions vs. SMARD’s actual offshore generation, 2019-2025.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"K7qw0PTV6H"}],"key":"Qyt0jPWJlZ"}],"key":"s98VSmPC0Z"}],"label":"fig-35-fit-quality-vs-smard","identifier":"fig-35-fit-quality-vs-smard","enumerator":"2","html_id":"fig-35-fit-quality-vs-smard","key":"aAiRk4tiGO"},{"type":"heading","depth":2,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Reading the result","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"pmY2J0NK8n"}],"identifier":"reading-the-result","label":"Reading the result","html_id":"reading-the-result","implicit":true,"key":"kjZJ57zEcF"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"The optimal capacity vector drives bias to roughly zero (vs. a clear\npositive bias from the MaStR-derived weights) -- a real chunk of the\npreviously-observed bias ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"f3g0bXKRxB"},{"type":"strong","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"is","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"ByyS6alMXB"}],"key":"O6GooXHGOy"},{"type":"text","value":" attributable to our own capacity\naccounting, not to PECD’s modeling or to curtailment. But correlation\nbarely moves between the two -- reweighting capacity fixes the ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"rY7HCxs3rP"},{"type":"emphasis","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"level","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"U4BHwos5OL"}],"key":"ro81GQFJyA"},{"type":"text","value":",\nnot the ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"z5QQu8yMlf"},{"type":"emphasis","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"shape","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"r9B6fAs1cd"}],"key":"lQYmExTmq9"},{"type":"text","value":". Since the fitted vector is, by construction, the best\nany monotonic per-zone capacity story can possibly do, the remaining\ncorrelation gap can’t be closed by better fleet data -- it needs\nsomething dynamic that a static (or monotonically growing) capacity\nvector structurally can’t represent: curtailment, outages, or another\ntime-varying effect neither this fit nor PECD’s own product attempts to\nmodel.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"Imgx4pYx0Q"}],"key":"BHDPlhoUTi"}],"key":"Wx6TpYklgv"}],"key":"EvrChv2fcx"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Comparing all wind-offshore approaches, plus SMARD","url":"/notebooks/compare-wind-offshore-approaches","group":"Wind offshore replication"},"next":{"title":"What drives the offshore gap against SMARD?","url":"/notebooks/analyse-wind-offshore-bias-drivers","group":"Wind offshore replication"}}},"domain":"http://localhost:3000"}